          m_underlyingValue: {fileID: 11400000, guid: 3e4504c21a681a04f96bf2c7ab959850, type: 2}
    - rid: 4421949405142188181
      type: {class: NPCDialogueCommand, ns: , asm: Assembly-CSharp}
      data:
        m_dialogue: Greetings Traveler! Can you help me pick these crops? I'll open
          the gate if you do
    - rid: 4421949405142188198
      type: {class: NPCDialogueCommand, ns: , asm: Assembly-CSharp}
      data:
        m_dialogue: Did you pick them yet?
    - rid: 4421949423477063765
      type: {class: NPCTryRemoveItemCommand, ns: , asm: Assembly-CSharp}
      data:
        m_requiredAmount: 5
        m_itemToCheck: {fileID: 11400000, guid: 6092a75117df09d42871e507c19ea0d5, type: 2}
        m_checkSuccessCommand:
          rid: 4421949423477063796
        m_checkFailureCommand:
          rid: 4421949423477063767
    - rid: 4421949423477063767
      type: {class: NPCDialogueCommand, ns: , asm: Assembly-CSharp}
      data:
        m_dialogue: I don't see the vegetables!
    - rid: 4421949423477063796
      type: {class: NPCChainCommand, ns: , asm: Assembly-CSharp}
      data:
        m_commandsToChain:
        - rid: 4421949423477063797
        - rid: 4421949423477063798
        - rid: 4421949444927258716
        - rid: 4421949444927258719
    - rid: 4421949423477063797
      type: {class: NPCDialogueCommand, ns: , asm: Assembly-CSharp}
      data:
        m_dialogue: Thank You! I will go unblock the way!
    - rid: 4421949423477063798
      type: {class: NPCVoidEventCommand, ns: , asm: Assembly-CSharp}
      data:
        m_onCommandExecuted:
          m_PersistentCalls:
