                m_BoolArgument: 0
              m_CallState: 2
    - rid: 4421949444927258716
      type: {class: NPCDialogueCommand, ns: , asm: Assembly-CSharp}
      data:
        m_dialogue: Go talk to the lady in front of the inn, she can help you next
    - rid: 4421949444927258719
      type: {class: NPCStartQuestCommand, ns: , asm: Assembly-CSharp}
