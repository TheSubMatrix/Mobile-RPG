    RefIds:
    - rid: 4421949405142188178
      type: {class: NPCChainCommand, ns: , asm: Assembly-CSharp}
      data:
        m_commandsToChain:
        - rid: 4421949405142188180
        - rid: 4421949405142188181
    - rid: 4421949405142188180
